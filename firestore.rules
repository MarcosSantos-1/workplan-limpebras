rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cronogramas: qualquer usuário autenticado lê e cria; ninguém apaga pelo app.
    match /cronogramas/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.criadoPor.uid == request.auth.uid
        && request.resource.data.status in ['rascunho', 'publicado'];
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'publicadoEm', 'publicadoPor'])
        && request.resource.data.status in ['rascunho', 'publicado', 'arquivado'];
      allow delete: if false;
    }
  }
}
