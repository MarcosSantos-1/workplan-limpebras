rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function userPath(e) { return /databases/$(database)/documents/usuarios/$(e); }
    function me() { return get(userPath(myEmail())).data; }
    function isActive() { return signedIn() && exists(userPath(myEmail())) && me().status == 'ativo'; }
    function isAdmin() { return isActive() && me().papel == 'admin'; }
    function isEditor() { return isActive() && me().papel in ['admin', 'editor']; }
    function bootstrapPath() { return /databases/$(database)/documents/config/bootstrap; }

    // ---------------- Acessos ----------------
    match /usuarios/{email} {
      // Convite pendente pode ser consultado sem login (tela de primeiro acesso).
      allow get: if resource.data.status == 'pendente'
                 || (signedIn() && (myEmail() == email || isAdmin()));
      allow list: if isAdmin();

      allow create: if
        // admin libera um e-mail
        (isAdmin()
          && request.resource.data.status == 'pendente'
          && request.resource.data.email == email
          && request.resource.data.papel in ['admin', 'editor', 'leitor'])
        // primeiro administrador (uma única vez, junto com config/bootstrap)
        || (signedIn() && email == myEmail()
          && !exists(bootstrapPath()) && existsAfter(bootstrapPath())
          && request.resource.data.papel == 'admin'
          && request.resource.data.status == 'ativo');

      allow update: if
        // admin altera papel/status/nome (não mexe no próprio cadastro)
        (isAdmin() && email != myEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['papel', 'status', 'nome', 'atualizadoEm'])
          && request.resource.data.papel in ['admin', 'editor', 'leitor']
          && request.resource.data.status in ['pendente', 'ativo', 'bloqueado'])
        // o próprio usuário ativa o convite no primeiro acesso
        || (signedIn() && email == myEmail()
          && resource.data.status == 'pendente'
          && request.resource.data.status == 'ativo'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uid', 'ativadoEm']));

      allow delete: if isAdmin() && resource.data.status == 'pendente';
    }

    match /config/bootstrap {
      allow get: if signedIn();
      allow create: if signedIn() && !exists(bootstrapPath())
        && getAfter(userPath(myEmail())).data.papel == 'admin';
    }

    // ---------------- Cronogramas ----------------
    match /cronogramas/{id} {
      allow read: if isActive();
      allow create: if isEditor()
        && request.resource.data.criadoPor.uid == request.auth.uid
        && request.resource.data.status in ['rascunho', 'publicado'];
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'publicadoEm', 'publicadoPor'])
        && request.resource.data.status in ['rascunho', 'publicado', 'arquivado'];
      allow delete: if false;
    }
  }
}
